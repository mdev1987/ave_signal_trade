# ============ TELEGRAM NOTIFY ============
BOT_TOKEN=<reporting-bot-token>
CHAT_ID=<your-chat-id>

# ============ DATA PROVIDERS ============
HELIUS_API_KEYS=<key1,key2>
SHYFT_API_KEY=<shyft-key>
TATUM_API_KEY=<tatum-key>
SOLTRACKER_BASE_URL=https://data.solanatracker.io
SOLTRACKER_API_KEY=<solanatracker-key>
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RPM=300

# ============ DBOTX (fail-open rug filter) ============
# Get key from https://dbotx.com/dashboard
# If IP whitelisting is enabled, add the VPS egress IP.
DBOTX_API_KEY=<dbotx-key>            # leave empty to disable the safety check
DBOTX_SAFETY=1                       # 0 to disable
DBOTX_TOP10_MAX=0.25                 # skip if top-10 holders own more than 25%

# ============ SOLANATRACKER (wallet scoring + safety + KOL feed) ============
SOLTRACKER_API_KEY=<solanatracker-key>  # leave empty to disable all SolanaTracker features
SOLTRACKER_KOL_FEED=false              # enable KOL trade polling (needs Advanced tier €50/mo)
SOLTRACKER_KOL_POLL_S=30               # poll interval for KOL trades (seconds)
SOLTRACKER_RISK_GATE=true              # enable risk score pre-filter (before DBotX)
SOLTRACKER_RISK_MAX_SCORE=7            # reject tokens with risk score > this (1-10)
SOLTRACKER_SNIPER_FILTER=false         # enable sniper detection filter
SOLTRACKER_SNIPER_MAX_PCT=30           # max % of snipers among first-buyers
SOLTRACKER_WALLET_REFRESH_H=4          # hours between wallet score refresh

# ============ WALLET-QUALITY WEIGHTING ============
# Consensus = sum of wallet weights (win-rate + PnL based).
# Token fires when summed weight of distinct buying wallets >= threshold.
WALLET_PERF_PATH=wallet_performance.json
WALLET_WEIGHT_FLOOR_WIN=0.40         # win rate below this -> weight 0 (noise)
WALLET_WEIGHT_FULL_WIN=0.60          # win rate at/above this -> base weight 1.0
WALLET_PNL_TIER1=1000000             # >=$1M PnL -> 1.25x weight
WALLET_PNL_TIER2=5000000             # >=$5M PnL -> 1.5x weight
WALLET_WEIGHT_TIER1_MULT=1.25
WALLET_WEIGHT_TIER2_MULT=1.5
WALLET_DEFAULT_WEIGHT=0.5            # weight when perf data is missing
WALLET_WEIGHT_MAX=2.0
CONSENSUS_WEIGHT_THRESHOLD=1.5
REQUIRE_STRONG_WALLET=true

# ============ WATCHER ============
WATCH_POLL_S=120                     # fallback poll cadence (push preferred)
WATCH_MIN_BUY_USD=50                 # ignore smaller smart entries
WATCH_CONSENSUS_WALLETS=2            # N wallets into same CA => CONSENSUS alert
WATCH_CONSENSUS_WINDOW_S=600         # 10-min consensus window
WATCH_FIRST_LOOKBACK_S=90            # startup lookback (defers live opens)
WATCH_WEBHOOK_URL=                   # public URL; empty = polling only
WATCH_WEBHOOK_PORT=8787
STATUS_EVERY_MIN=30                  # periodic status card to Telegram
OPEN_GAP_S=20                        # min seconds between new positions

# ============ SHADOW PAPER BOOK ============
SIZE_SOL=0.05
TP_LADDER=1.3:0.4,1.8:0.3,3.0:0.3  # scale-out ladder: +30%/+80%/+200%
TRAIL_ENABLED=true                   # trailing stop after peak >= start mult
TRAIL_START_MULT=1.4
TRAIL_RETRACE_PCT=0.25               # exit 25% below running peak
HARD_STOP_PCT=0.25                   # disaster stop at -25% from entry
BE_BUFFER_PCT=0.0                    # after 1st TP, stop -> breakeven
MAX_HOLD_H=24                        # force-close dead positions after 24h
MAX_OPEN_POSITIONS=18                # hard cap on concurrent shadow positions
PER_WALLET_MAX_POSITIONS=3           # cap open positions that share a wallet
OPEN_MIN_WALLETS=2                   # minimum distinct qualified wallets to open
OPEN_MAX_IMPACT_PCT=5.0              # skip open if Jupiter buy-side impact > this (align with Jupiter gate)
OPEN_MIN_H1_PCT=0.0                  # require 1h price change >= this (uptrend only)
OPEN_MAX_M5_DUMP_PCT=-5.0            # skip if 5m change < this (don't enter dumps)
OPEN_MIN_LIQ_USD=1500                # minimum pool liquidity in USD
START_BALANCE_SOL=4.0                # paper book balance
SHADOW_STATE_FILE=shadow_book.json

# ============ MULTI-TIMEFRAME ALIGNMENT ============
# Bonus score for trend-shaped tokens (all TFs agree). Weak/poor pairs still
# trade but need higher alignment to clear the threshold.
MTF_ALIGN_BONUS=0.3

# ============ PAIR-QUALITY ADAPTIVE ============
# Per-wallet-pair multiplier (rolling window, seeded from journal).
# Known-losing pairs (e.g. AgmLJ+kEFiA) get 0.5x; unknown pairs stay at 1.0.
PAIR_PERF_FILE=pair_performance.json

# ============ EARLY ADVERSE FILTER (one-shot at 30s) ============
# Reject positions that draw down >DD% AND gain <Gain% during the first
# N seconds.  Backtested: 20% DD / 5% gain / 30s moves gross from -0.447
# to +0.335 SOL on 2026-08-13 replay.
EARLY_FILTER_WINDOW_S=30.0             # evaluate at this age (seconds)
EARLY_FILTER_DD_PCT=20.0               # reject if drawdown > this %
EARLY_FILTER_GAIN_PCT=5.0              # AND gain < this %

# ============ JUPITER (paper pricing / live sim) ============
JUPITER_API_KEY=<jupiter-key>
JUPITER_SLIPPAGE_BPS=300
JUPITER_MAX_IMPACT_PCT=5.0

# ============ TELEGRAM SIGNAL FEED (@gmgnsignals) ============
# Listens to GMGN's Telegram channel for real-time token alerts.
# The channel IS the consensus — no wallet tracking needed.
TG_SIGNAL_ENABLED=true
TG_SIGNAL_CHANNEL=gmgnsignals      # Telegram channel (without @)
TG_API_ID=                         # Telegram API ID (from my.telegram.org)
TG_API_HASH=                       # Telegram API hash
TG_PHONE=                          # Telegram phone number
TG_SESSION_NAME=tg_signal          # Telethon session file name
TG_MIN_MC=5000                     # min market cap to forward signal
TG_MIN_LIQ=1000                    # min liquidity to forward signal
TG_MIN_HOLDERS=10                  # min holder count to forward signal

# ============ RPC ============
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GATEKEEPER_RPC_URL=https://api.mainnet-beta.solana.com

# ============ LIVE TRADING (throwaway wallet) ============
PRIVATE_KEY=<throwaway-base58-private-key>
