# Ave Signal Trader — configuration template.
# Mirror of the operator's .env (2026-08-22) with every secret replaced by a
# placeholder. Copy to `.env` and fill in your own keys:
#
#   cp .env.example .env
#

# ============ JUPITER (execution + price fallback) ============
# Base: https://api.jup.ag  (/price/v3 + /swap/v2). FREE tier = 1 RPS.
JUPITER_API_KEY=<your-jupiter-api-key>

# ============ PUMP.FUN FEED (new-token detection) ============
# pumpapi.io — free, no API key. Server pushes all events; bot filters to pump.fun.
PUMPAPI_WSS=wss://stream.pumpapi.io/

# NOTE: SHYFT / CABALSPY / COINSTATS / PUMPDEV / DEXSCREENER keys are NOT
# consumed by the current runtime (no code path reads them). They are left
# out of this template until their modules are actually wired in.

# ============ SOLANA RPC (optional reads) ============
# Not required for the Jupiter /order + /execute path (the swap API quotes and
# lands transactions itself). Used only for wallet balance + token reads.
# HELIUS_API_KEYS: comma-separated keys, newest first. The client always tries
# the newest key first and falls back down the list when it is 429-rate-limited,
# so an exhausted key never wedges wallet balance reads.
HELIUS_API_KEYS=<helius-key-1>,<helius-key-2>
# Base endpoints (no api-key — the client appends ?api-key=<newest key>).
# Gatekeeper (beta) is Helius's low-latency edge router: beta.helius-rpc.com
# removes Cloudflare from the critical path (tens-to-hundreds of ms faster)
# and supports all RPC + Enhanced Transactions endpoints.
SOLANA_RPC_URL=https://beta.helius-rpc.com
GATEKEEPER_RPC_URL=https://beta.helius-rpc.com
PARSE_TXS=https://beta.helius-rpc.com/v0/transactions
PARSE_TX_HISTORY=https://beta.helius-rpc.com/v0/addresses/{address}/transactions

# =============== RUG CHECK =========================
# Arm-time security veto: only explicit danger risks reject (fail-open).
# Evidence: the 2026-08-20 LP-pull rugs (TONK/NEX Ai/NiuLai) all carried
# "Large Amount of LP Unlocked"; winners never did. Scores are NOT used by
# default (winners and rugs both scored ~65 normalised).
RUGCHECK_ENABLED=true
RUGCHECK_API_KEY=<your-rugcheck-api-key>
RUGCHECK_BASE_URL=https://api.rugcheck.xyz
RUGCHECK_VETO_RISKS=lp unlocked,mint authority,freeze authority
RUGCHECK_MAX_SCORE=0
RUGCHECK_TIMEOUT_S=2.0
RUGCHECK_CACHE_TTL_S=120
# false = missing report at snipe time ADMITS the token (sec-0 entries survive)
RUGCHECK_FAIL_CLOSED=false

# ============ SERIAL-RELAUNCH DAMPER ========================
# Same token name on >= N distinct CAs within WINDOW_MIN minutes => reject.
# NEX Ai appeared under 5+ CAs and NiuLai under ~20 within hours; every one
# was a relaunch farm. Runs AFTER the base filter (no blast radius on spam).
SCAM_DAMPER_ENABLED=true
SCAM_DAMPER_MAX_CAS=3
SCAM_DAMPER_WINDOW_MIN=360

# ============ PUMPAPI POOL GATE (zero latency, from the stream) ============
# The stream carries burnedLiquidity / quoteInPool / authorities on every
# event. A liquidity REMOVAL seen within VETO_S rejects outright; burned-LP
# below MIN_PCT rejects when >0 (0 = log-only until measured — pumpapi docs
# flag 0% burned as rug-able; features are journaled per entry as `poolfeat`).
LIQ_REMOVE_VETO_S=120
MIN_BURNED_LIQ_PCT=0

# ============ TELEGRAM ALERTS / REPORTING ============
BOT_TOKEN=<botfather-token>
CHAT_ID=<telegram-chat-id>

TELEGRAM_API_ID=<my.telegram.org-api-id>
TELEGRAM_API_HASH=<my.telegram.org-api-hash>
TELEGRAM_PHONE=+15550000000

# ============ DEXPAPRIKA (price + streaming) ============
DEX_PAPRIKA_KEY=<dexpaprika-key>
# REST Base URL
DEX_PAPRIKA_REST_URL=https://api.dexpaprika.com
# Streaming Base URL
DEX_PAPRIKA_STREAMING_URL=https://streaming.dexpaprika.com

# --- helius dev-reputation veto (read-only, FAIL-CLOSED when enabled) ---
# Uses HELIUS_API_KEYS (see SOLANA RPC section) — rotated on 429 so an
# exhausted key doesn't kill the signal. If Helius cannot answer while this
# gate is enabled, the token is REJECTED (an unverified pool is not bought).
HELIUS_BASE_URL=https://beta.helius-rpc.com
DEV_REP_ENABLED=true
# warn = journal dev-rep failures and ADMIT (measure the false-positive rate
# on real trades before letting it hard-reject); reject = fail-closed veto.
DEV_REP_MODE=warn
DEV_REP_MAX_CREATES_24H=3
DEV_REP_MIN_AGE_HOURS=0
DEV_REP_CACHE_TTL_MIN=10
DEV_REP_TIMEOUT_S=2.5
MIN_LIQUIDITY_USD=5000
ENTRY_LATENCY_S=2
LIQ_CONFIRM_WINDOW_S=10
MAX_ENTRY_MULT=5.0
MAX_ENTRY_PEAK_PCT=0.0
# Re-tuned 2026-08-21 on the honest-engine replay (scripts/replay_tune.py,
# 2026-08-13 feed): mcap $5-20K + snipes>=3 + sec 0 -> n=105/day, 32.4% realized
# 4x TP, EV +101%/trade, win3x 33%. The earlier 8000 mcap floor left only
# n=6 trades/day — no sample. Dead pools are handled by the fail-closed gates
# and the fast timeout writeoff, not by starving the filter.
#
# Named regime so L1/L2 statistics never mix. L1_PRODUCTION = $5K-20K +
# snipes>=3 (the replay-validated edge); L2_EXPERIMENT = $2.5K-50K + snipes>=1.
# Explicit FILTER_* values below still override the profile.
FILTER_PROFILE=L2_EXPERIMENT
FILTER_MCAP_USD_MIN=2500
FILTER_MCAP_USD_MAX=50000
FILTER_SNIPES_MIN=1
FILTER_SEC_SCORE_MAX=0
# Allowed DEX set, CSV, exact-match. ``*`` admits every dex (paper research
# mode; real dex name is recorded per trade for venue analysis). For the
# validated L1 production core use FILTER_DEXS=Pumpfunamm.
FILTER_DEXS=*

# --- trading (live sizing) ---
# SOL notional per position; paper starting balance; max concurrent positions.
# FIX 2026-08-21: wallet holds 0.025 SOL (Helius getBalance 25021025 lamports).
# 0.02 + ATA rent 2.03M + fees > buffer → Jupiter live quote returns
# 400 "Failed to get quotes" (insufficient funds, mis-classified as no_route).
# Drop to 0.01 SOL (40% of wallet, leaves ~0.013 SOL after rent/fees) so
# CATHOLIC/MENSA/6xsp quotes succeed with taker (verified live: 20M=400, 10M=200).
POSITION_SIZE_SOL=0.01
START_BALANCE_SOL=0.025
MAX_POSITIONS=1
TAKE_PROFIT=4.0
STOP_LOSS=0.3
# 25min = honest-engine replay optimum (25m ~+99.6% EV vs 60m +101.4% while
# freeing the slot 2.4x faster). Tuned band 1500-1800s.
TIMEOUT_S=1500

# --- sell robustness (dead-pool writeoffs) ---
# After MAX_SELL_FAILURES consecutive failed sells a position is written off
# (closed at its last mark, slot freed, Telegram alert). Positions PAST their
# timeout window write off sooner: after MAX_SELL_FAILURES_TIMEOUT failures —
# the hold window is already over, so a dead pool there frees the slot fast.
MAX_SELL_FAILURES=6
MAX_SELL_FAILURES_TIMEOUT=3
SELL_BACKOFF_S=60.0

# --- price sanity / staleness guards ---
MIN_ENTRY_PX=1e-11
MAX_ENTRY_PX=1e-3
PRICE_STALE_S=120
TIMEOUT_STALE_GRACE_S=300
MAX_TICK_MULT=100000

# --- run mode ---
# false = LIVE trading (real orders; requires PRIVATE_KEY below).
# true  = paper mode (quote gate only, never signs/executes).
# NOTE: DRY_RUN always wins — paper mode never even loads PRIVATE_KEY.
DRY_RUN=true
# Paper fill simulation: fill entries at the real Jupiter quote price
# (slippage + impact) and mark exits with a simulated sell that applies
# sell slippage — matches live fills instead of the raw feed tick.
PAPER_FILL_SIM=true
# Wallet private key (base58) — REQUIRED for live trading. NEVER use your main wallet.
PRIVATE_KEY=<base58-wallet-private-key>

# --- jupiter entry gate (paper experiment 2026-08-23) ---
# Tightened from 500/15.0 per 4-rug investigation (CATE/ELON/Google-AI/STAR).
# 5% is the max buy impact for 0.1 SOL snipes; sell side verified separately.
# SELL-side slippage only (also the paper_sell_proceeds default).
JUPITER_SLIPPAGE_BPS=300
# true = omit slippageBps on BUY /order so Jupiter applies RTSE optimized
# slippage in "ultra" mode with ALL routers eligible (Metis/JupiterZ RFQ/
# Dflow/OKX). Any optional param on /order flips it to "manual" mode which
# may restrict routing (Jupiter routing-impact matrix). Returned router/
# mode/slippageBps are journaled per quote as diagnostics.
JUPITER_ORDER_RTSE=true
JUPITER_MAX_IMPACT_PCT=5.0
REQUIRE_SELL_QUOTE=true
MAX_SELL_IMPACT_PCT=5.0
QUOTE_STABILITY_CHECKS=3
QUOTE_STABILITY_INTERVAL_MS=300
MAX_QUOTE_CHANGE_PCT=5.0
MAX_IMPACT_CHANGE_PCT=3.0
JUPITER_QUOTE_RETRIES=3
JUPITER_QUOTE_CACHE_S=30
JUPITER_QUOTE_THROTTLE_S=1.0
