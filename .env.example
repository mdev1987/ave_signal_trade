# ============ TELEGRAM NOTIFY ============
TELEGRAM_API_ID=<my.telegram.org-api-id>
TELEGRAM_API_HASH=<my.telegram.org-api-hash>
TELEGRAM_SESSION=telegram_session
BOT_TOKEN=<reporting-bot-token>
CHAT_ID=<your-chat-id>

# ============ SMART-WALLET WATCHER ============
HELIUS_API_KEYS=<key1,key2>
SHYFT_API_KEY=<shyft-key>
SHYFT_RPC_URL=https://rpc.shyft.to
TATUM_API_KEY=<tatum-key>
WATCH_POLL_S=45
WATCH_MIN_BUY_USD=50
WATCH_CONSENSUS_WALLETS=2
WATCH_CONSENSUS_WINDOW_S=600
WATCH_FIRST_LOOKBACK_S=90
WATCH_WEBHOOK_URL=            # public URL for Tatum push (optional)
WATCH_WEBHOOK_PORT=8787
STATUS_EVERY_MIN=30
OPEN_GAP_S=20

# ============ WALLET-QUALITY WEIGHTING (data-driven consensus) ============
# Each tracked wallet is weighted by its real win rate + PnL (SolanaTracker PnL
# V2). A token fires when the summed weight of distinct buying wallets reaches
# CONSENSUS_WEIGHT_THRESHOLD (1.5 ~= a strong wallet [>=1.0, i.e. >=60% win]
# plus any second tracked wallet; REQUIRE_STRONG_WALLET enforces that at least
# one contributor is a proven winner, so two mediocre wallets can't open alone).
WALLET_PERF_PATH=wallet_performance.json
WALLET_WEIGHT_FLOOR_WIN=0.40   # win rate below this -> weight 0 (noise)
WALLET_WEIGHT_FULL_WIN=0.60    # win rate at/above this -> base weight 1.0
WALLET_PNL_TIER1=1000000       # >=$1M PnL -> 1.25x weight
WALLET_PNL_TIER2=5000000       # >=$5M PnL -> 1.5x weight
WALLET_WEIGHT_TIER1_MULT=1.25
WALLET_WEIGHT_TIER2_MULT=1.5
WALLET_DEFAULT_WEIGHT=0.5      # weight when perf data is missing
WALLET_WEIGHT_MAX=2.0
CONSENSUS_WEIGHT_THRESHOLD=1.5
REQUIRE_STRONG_WALLET=true

# ============ SHADOW PAPER BOOK ============
SIZE_SOL=0.05
TP_LADDER=1.3:0.4,1.8:0.3,3.0:0.3
TP1_MULT=1.30
TRAIL_ENABLED=true
TRAIL_START_MULT=1.4
TRAIL_RETRACE_PCT=0.25
HARD_STOP_PCT=0.25
BE_BUFFER_PCT=0.0
MAX_HOLD_H=24
MAX_OPEN_POSITIONS=18
PER_WALLET_MAX_POSITIONS=3
OPEN_MAX_IMPACT_PCT=4.0          # skip open if Jupiter buy-side impact exceeds this (execution risk)
OPEN_MIN_H1_PCT=0.0                # require 1h price change >= this (only enter uptrends, skip tops/flat)
OPEN_MAX_M5_DUMP_PCT=-5.0          # skip if 5m price change < this (don't enter a token dumping at the signal)
MTF_ALIGN_BONUS=0.3              # multi-timeframe alignment score modifier (trend-shaped tokens bonus, reversing discount)
# DBotX data API — fail-open rug/safety filter (mint/freeze authority, top-10 concentration).
# Get key from https://dbotx.com/dashboard ; if you enable API IP whitelisting, add the VPS IP.
DBOTX_API_KEY=                   # leave empty to disable the safety check
DBOTX_SAFETY=1                   # 0 to disable
DBOTX_TOP10_MAX=0.25             # skip if top-10 holders own more than 25%
PAIR_PERF_FILE=pair_performance.json  # adaptive pair-quality penalty store (seeded from journal)
EARLY_EXIT_WINDOW_S=0.0          # if >0, fast-rug guard: close positions dropping EARLY_EXIT_DROP_PCT% within this many seconds
EARLY_EXIT_DROP_PCT=0.30
OPEN_MIN_LIQ_USD=1500
START_BALANCE_SOL=4.0
SHADOW_STATE_FILE=shadow_book.json

# ============ JUPITER (paper pricing / live sim) ============
JUPITER_API_KEY=<jupiter-key>
JUPITER_SLIPPAGE_BPS=300
JUPITER_MAX_IMPACT_PCT=5.0

# ============ DEXSCREENER ============
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RPM=300

# ============ SOLANATRACKER (wallet PnL ranking) ============
SOLTRACKER_BASE_URL=https://data.solanatracker.io
SOLTRACKER_API_KEY=<solanatracker-key>

# ============ RPC ============
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GATEKEEPER_RPC_URL=https://api.mainnet-beta.solana.com

# ============ LIVE TRADING (throwaway wallet) ============
PRIVATE_KEY=<throwaway-base58-private-key>
