# Ave Signal Trader — configuration.
# Copy to `.env` and fill in the secrets. All keys are optional; every value
# has a built-in default shown here. Use `KEY=value`.
#
#   cp .env.example .env
#
# Telegram control works only when BOT_TOKEN + CHAT_ID are set; the trade gate
# (Jupiter quote + execution) only when JUPITER_API_KEY is set.

# --- secrets (placeholders) -----------------------------------------------
# Telegram bot token from @BotFather (drives /start /stop /status /help).
BOT_TOKEN=
# Chat id that receives the cards (/status, open/close/reject, ...).
CHAT_ID=
# Telegram user-session credentials (my.telegram.org/apps) — needed to read
# the signal channel. TELEGRAM_PHONE prompts once on first run if unset.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Jupiter API key (api.jup.ag, optional but recommended for the quote gate).
JUPITER_API_KEY=
# Wallet key for REAL trading. Only used when DRY_RUN=false. Use a throwaway
# key — never a funded main wallet. Omit for paper mode.
PRIVATE_KEY=

# --- trading ---------------------------------------------------------------
# SOL notional per position.
POSITION_SIZE_SOL=0.1
# Starting paper balance reported by /status.
START_BALANCE_SOL=10.0
# Take-profit / stop-loss / timeout exits (multiples and seconds).
TAKE_PROFIT=4.0
STOP_LOSS=0.3
TIMEOUT_S=3600.0
# Seconds to wait for in-flight trades to finish on /stop before exiting.
SHUTDOWN_GRACE_S=60
# Signal channel to monitor (with @).
TELEGRAM_CHANNEL=@AveSolanaTokenScanner
# JSON checkpoint file for open/closed positions.
CHECKPOINT_FILE=paper_positions.json
# How many past signals to backfill on startup.
BACKFILL_LIMIT=200

# --- entry guards ------------------------------------------------------------
# Reject arm-time when signal liquidity is below this (USD).
MIN_LIQUIDITY_USD=4000
# Wait this long after a signal before entering (let the pool settle/index).
ENTRY_LATENCY_S=2
# How long to keep retrying the DexPaprika liquidity check before giving up.
LIQ_CONFIRM_WINDOW_S=10
# Skip entry if the observed price already ran above N x the signal init price.
MAX_ENTRY_MULT=5
# Skip entry if the price is already above init by this many % (0 = off).
MAX_ENTRY_PEAK_PCT=0

# --- pool check (DexPaprika + Helius arm-time gates) -------------------------
# Master switch for the liquidity/survival + dev-reputation gates.
POOL_CHECK_ENABLED=true
# DexPaprika API key (free tier works without one).
DEX_PAPRIKA_KEY=
DEX_PAPRIKA_REST_URL=https://api.dexpaprika.com
# Comma-separated Helius API keys (rotated on 429); alias HELIUS_API_KEY.
HELIUS_API_KEYS=
HELIUS_BASE_URL=https://mainnet.helius-rpc.com
# Helius creator/dev-reputation veto (fail-open on API error).
DEV_REP_ENABLED=true
DEV_REP_MAX_CREATES_24H=3
DEV_REP_MIN_AGE_HOURS=0
DEV_REP_CACHE_TTL_MIN=10
DEV_REP_TIMEOUT_S=2.5

# --- jupiter ---------------------------------------------------------------
# true = paper trading (quote gate only, never signs/executes).
# false = real orders; requires PRIVATE_KEY or the bot refuses to start.
DRY_RUN=true
# Jupiter API endpoint (normal use: leave default).
JUPITER_BASE_URL=https://api.jup.ag
# Default sell slippage in basis points.
JUPITER_SLIPPAGE_BPS=500
# Quote-gate cap on price impact (%); above this the signal is rejected.
JUPITER_MAX_IMPACT_PCT=15.0
# Max attempts per quote-gate request.
JUPITER_QUOTE_RETRIES=3
# Quote cache TTL (seconds) — collapses launch bursts.
JUPITER_QUOTE_CACHE_S=30.0
# Min spacing between quote requests (seconds) — Jupiter free tier.
JUPITER_QUOTE_THROTTLE_S=1.0
# Delay between quote retries (seconds).
JUPITER_QUOTE_RETRY_DELAY_S=1.0
# Slippage ladder (bps) tried when a sell keeps failing.
SELL_SLIPPAGE_ESCALATION=200,300,500,1000

# --- price feed ------------------------------------------------------------
PUMPAPI_WSS=wss://stream.pumpapi.io/
# Reconnect delay when the websocket drops (seconds).
PUMPAPI_RECONNECT_S=3.0
# How long to wait for a fresh price tick before giving up (seconds).
PRICE_WAIT_TIMEOUT_S=30.0