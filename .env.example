# Ave Signal Trader — configuration.
# Copy to `.env` and fill in the secrets. All keys are optional; every value
# has a built-in default shown here. Use `KEY=value`.
#
#   cp .env.example .env
#
# Telegram control works only when BOT_TOKEN + CHAT_ID are set; the trade gate
# (Jupiter quote + execution) only when JUPITER_API_KEY is set.

# --- secrets (placeholders) -----------------------------------------------
# Telegram bot token from @BotFather (drives /start /stop /status /help).
BOT_TOKEN=
# Chat id that receives the cards (/status, open/close/reject, ...).
CHAT_ID=
# Telegram user-session credentials (my.telegram.org/apps) — needed to read
# the signal channel. TELEGRAM_PHONE prompts once on first run if unset.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Jupiter API key (api.jup.ag, optional but recommended for the quote gate).
JUPITER_API_KEY=
# Wallet key for REAL trading. Only used when DRY_RUN=false. Use a throwaway
# key — never a funded main wallet. Omit for paper mode.
PRIVATE_KEY=

# --- trading ---------------------------------------------------------------
# SOL notional per position.
POSITION_SIZE_SOL=0.1
# Starting paper balance reported by /status.
START_BALANCE_SOL=2.0
# Max concurrent open positions (new signals skip when reached).
MAX_POSITIONS=5
# Take-profit / stop-loss / timeout exits (multiples and seconds).
TAKE_PROFIT=4.0
STOP_LOSS=0.3
TIMEOUT_S=3600.0
# Seconds to wait for in-flight trades to finish on /stop before exiting.
SHUTDOWN_GRACE_S=60
# No sweep progress this long (s) -> health watchdog force-exits for a restart
# (guards against a wedged event loop; 0 disables).
HEALTH_TIMEOUT_S=300
# Periodic checkpoint flush (s) so a forced/killed exit loses little state.
CHECKPOINT_SAVE_S=300
# Signal channel to monitor (with @).
TELEGRAM_CHANNEL=@AveSolanaTokenScanner
# JSON checkpoint file for open/closed positions.
CHECKPOINT_FILE=paper_positions.json
# How many past signals to backfill on startup.
BACKFILL_LIMIT=200

# --- price sanity / staleness guards ----------------------------------------
# Reject entries whose SOL/token price is outside this band (dust/garbage).
MIN_ENTRY_PX=1e-11
MAX_ENTRY_PX=1e-3
# A last tick older than this (s) is "stale" — timeout exits wait for fresh.
PRICE_STALE_S=120
# Max extra wait (s) for a fresh tick before forcing the timeout exit.
TIMEOUT_STALE_GRACE_S=300
# Ticks beyond this multiple of the entry price are treated as feed noise.
MAX_TICK_MULT=100000

# --- entry guards ------------------------------------------------------------
# Reject arm-time when signal liquidity is below this (USD).
MIN_LIQUIDITY_USD=4000
# Signal mcap band (USD) enforced by the Telegram-signal filter. Defaults
# $5K-$20K; raise the floor to avoid ultra-dead early pumps (e.g. 8000-20000).
FILTER_MCAP_USD_MIN=5000
FILTER_MCAP_USD_MAX=20000
# Minimum snipes count in the signal, and max allowed security score.
FILTER_SNIPES_MIN=3
FILTER_SEC_SCORE_MAX=0
# Wait this long after a signal before entering (let the pool settle/index).
ENTRY_LATENCY_S=2
# How long to keep retrying the DexPaprika liquidity check before giving up.
LIQ_CONFIRM_WINDOW_S=10
# Skip entry if the observed price already ran above N x the signal init price.
MAX_ENTRY_MULT=5
# Skip entry if the price is already above init by this many % (0 = off).
MAX_ENTRY_PEAK_PCT=0

# --- pool check (DexPaprika + Helius arm-time gates) -------------------------
# Master switch for the liquidity/survival + dev-reputation gates.
POOL_CHECK_ENABLED=true
# DexPaprika API key (free tier works without one).
DEX_PAPRIKA_KEY=
DEX_PAPRIKA_REST_URL=https://api.dexpaprika.com
# Comma-separated Helius API keys, newest first (rotated on 429; the newest
# key is always preferred). Aliases: HELIUS_API_KEY. Placeholder below — put
# your real keys in .env.
HELIUS_API_KEYS=
HELIUS_BASE_URL=https://beta.helius-rpc.com
# Low-latency Helius edge router (Gatekeeper beta). Base URLs carry no key —
# the client appends ?api-key=<newest key> from HELIUS_API_KEYS.
GATEKEEPER_RPC_URL=https://beta.helius-rpc.com
SOLANA_RPC_URL=https://beta.helius-rpc.com
PARSE_TXS=https://beta.helius-rpc.com/v0/transactions
PARSE_TX_HISTORY=https://beta.helius-rpc.com/v0/addresses/{address}/transactions
# Helius creator/dev-reputation veto (fail-open on API error).
DEV_REP_ENABLED=true
DEV_REP_MAX_CREATES_24H=3
DEV_REP_MIN_AGE_HOURS=0
DEV_REP_CACHE_TTL_MIN=10
DEV_REP_TIMEOUT_S=2.5

# --- jupiter ---------------------------------------------------------------
# true = paper trading (quote gate only, never signs/executes).
# false = real orders; requires PRIVATE_KEY or the bot refuses to start.
DRY_RUN=true
# Paper fill simulation: fill entries at the real Jupiter quote price
# (slippage + impact) and mark exits with a simulated sell that applies
# sell slippage — matches live fills instead of the raw feed tick.
PAPER_FILL_SIM=true
# Jupiter API endpoint (normal use: leave default).
JUPITER_BASE_URL=https://api.jup.ag
# Default sell slippage in basis points.
JUPITER_SLIPPAGE_BPS=500
# Quote-gate cap on price impact (%); above this the signal is rejected.
JUPITER_MAX_IMPACT_PCT=15.0
# Max attempts per quote-gate request.
JUPITER_QUOTE_RETRIES=3
# Quote cache TTL (seconds) — collapses launch bursts.
JUPITER_QUOTE_CACHE_S=30.0
# Min spacing between quote requests (seconds) — Jupiter free tier.
JUPITER_QUOTE_THROTTLE_S=1.0
# Delay between quote retries (seconds).
JUPITER_QUOTE_RETRY_DELAY_S=1.0
# Slippage ladder (bps) tried when a sell keeps failing.
SELL_SLIPPAGE_ESCALATION=200,300,500,1000
# A drained pool never quotes again. After MAX_SELL_FAILURES consecutive failed
# sells the position is written off (closed at its last mark, slot freed) so a
# dead token can't hold a position slot or hammer the API forever.
MAX_SELL_FAILURES=6
# Min wait (s) between failed-sell retries (backoff; the 15s sweep used to
# retry a drained token ~60x/hour).
SELL_BACKOFF_S=60.0
# Trailing stop: once the peak reaches TRAIL_ACTIVATE_MULT x entry, ratchet a
# stop to peak * (1 - TRAIL_RETRACE_PCT). Locks in gains on runners that
# reverse after a big move instead of bleeding to the 1h timeout. 0 disables.
TRAIL_ACTIVATE_MULT=2.0
TRAIL_RETRACE_PCT=0.5
# --- network hardening (live reliability) -----------------------------------
# Every Jupiter/RPC call is wrapped in asyncio.wait_for with these hard caps,
# so a hung DNS resolver or dead socket can never freeze the event loop (the
# bot wedged 5+ minutes in live operation before this existed).
JUPITER_ORDER_TIMEOUT_S=20.0
JUPITER_EXECUTE_TIMEOUT_S=60.0
RPC_TIMEOUT_S=12.0
# After a Helius RPC key answers 429 it is skipped for this many seconds
# (rotation spreads wallet reads across every HELIUS_API_KEYS entry).
RPC_KEY_COOLDOWN_S=60.0
# Max entries kept in the quote cache (memory bound; TTL is JUPITER_QUOTE_CACHE_S).
JUPITER_QUOTE_CACHE_MAX=500

# --- price feed ------------------------------------------------------------
PUMPAPI_WSS=wss://stream.pumpapi.io/
# Reconnect delay when the websocket drops (seconds).
PUMPAPI_RECONNECT_S=3.0
# How long to wait for a fresh price tick before giving up (seconds).
PRICE_WAIT_TIMEOUT_S=30.0
# Reconnect if the websocket delivers no data for this long (wedged socket).
PUMPAPI_RECV_TIMEOUT_S=90.0