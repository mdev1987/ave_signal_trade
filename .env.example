# ============================================================
#  Smart-Watch — Solana trading bot configuration
#  Modes: watch (KOL consensus) | tg-trade (TG-first)
# ============================================================

# ---------- Telegram notifications ----------
BOT_TOKEN=<reporting-bot-token>
CHAT_ID=<your-chat-id>

# ---------- Telegram Signal Feed (@gmgnsignals) ----------
TG_SIGNAL_ENABLED=true
TG_SIGNAL_CHANNEL=gmgnsignals      # Telegram channel (without @)
TG_API_ID=                         # Telegram API ID (from my.telegram.org)
TG_API_HASH=                       # Telegram API hash
TG_PHONE=                          # Telegram phone number
TG_SESSION_NAME=tg_signal          # Telethon session file name
TG_MIN_MC=5000                     # min market cap to forward signal
TG_MIN_LIQ=1000                    # min liquidity to forward signal
TG_MIN_HOLDERS=10                  # min holder count to forward signal

# ---------- data providers ----------
HELIUS_API_KEYS=<key1,key2>
SHYFT_API_KEY=<shyft-key>
TATUM_API_KEY=<tatum-key>
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RPM=300

# ----------- SOL Tracker (watch mode only) --------------
SOLTRACKER_BASE_URL=https://data.solanatracker.io
SOLTRACKER_API_KEY=<solanatracker-key>
SOLTRACKER_KOL_FEED=false
SOLTRACKER_KOL_POLL_S=30
SOLTRACKER_RISK_GATE=true
SOLTRACKER_RISK_MAX_SCORE=7
SOLTRACKER_SNIPER_FILTER=false
SOLTRACKER_SNIPER_MAX_PCT=30
SOLTRACKER_WALLET_REFRESH_H=4

# ----------- DBotX (fail-open rug filter, watch mode only) --------------
DBOTX_API_KEY=<dbotx-key>
DBOTX_SAFETY=1
DBOTX_TOP10_MAX=0.25

# ============ WALLET-QUALITY WEIGHTING (watch mode only) ============
WALLET_PERF_PATH=wallet_performance.json
WALLET_WEIGHT_FLOOR_WIN=0.40
WALLET_WEIGHT_FULL_WIN=0.60
WALLET_PNL_TIER1=1000000
WALLET_PNL_TIER2=5000000
WALLET_WEIGHT_TIER1_MULT=1.25
WALLET_WEIGHT_TIER2_MULT=1.5
WALLET_DEFAULT_WEIGHT=0.5
WALLET_WEIGHT_MAX=2.0
CONSENSUS_WEIGHT_THRESHOLD=1.5
REQUIRE_STRONG_WALLET=true

# ---------- watcher (watch mode only) ----------
WATCH_POLL_S=120
WATCH_MIN_BUY_USD=50
OPEN_MIN_WALLETS=2
WATCH_CONSENSUS_WALLETS=2
WATCH_CONSENSUS_WINDOW_S=600
WATCH_WEBHOOK_URL=
WATCH_WEBHOOK_PORT=8787
STATUS_EVERY_MIN=30

# ---------- position management (shared) ----------
SIZE_SOL=0.05
TP_LADDER=1.3:0.4,1.8:0.3,3.0:0.3
TRAIL_ENABLED=true
TRAIL_START_MULT=1.4
TRAIL_RETRACE_PCT=0.25
HARD_STOP_PCT=0.25
BE_BUFFER_PCT=0.0
START_BALANCE_SOL=4.0
SHADOW_STATE_FILE=shadow_book.json
MAX_OPEN_POSITIONS=18
PER_WALLET_MAX_POSITIONS=3
OPEN_MAX_IMPACT_PCT=5.0
OPEN_MIN_H1_PCT=0.0
OPEN_MAX_M5_DUMP_PCT=-5.0
MTF_ALIGN_BONUS=0.3
PAIR_PERF_FILE=pair_performance.json
EARLY_FILTER_WINDOW_S=30.0
EARLY_FILTER_DD_PCT=20.0
EARLY_FILTER_GAIN_PCT=5.0
MAX_HOLD_H=24

# ---------- TG-first trading mode ----------
DRY_RUN=true                         # paper mode (set false for live trading)

# ---------- Telegram signal feed (@gmgnsignals) ----------
TG_SIGNAL_ENABLED=true
TG_SIGNAL_CHANNEL=gmgnsignals      # Telegram channel (without @)
TG_API_ID=                         # Telegram API ID (from my.telegram.org)
TG_API_HASH=                       # Telegram API hash
TG_PHONE=                          # Telegram phone number
TG_SESSION_NAME=tg_signal          # Telethon session file name
TG_MIN_MC=5000                     # min market cap to forward signal
TG_MIN_LIQ=1000                    # min liquidity to forward signal
TG_MIN_HOLDERS=10                  # min holder count to forward signal

# ---------- Jupiter (sim / live) ----------
JUPITER_API_KEY=<jupiter-key>
JUPITER_SLIPPAGE_BPS=300
JUPITER_MAX_IMPACT_PCT=5.0

# ---------- RPC ----------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GATEKEEPER_RPC_URL=https://api.mainnet-beta.solana.com
PRIVATE_KEY=<throwaway-base58-private-key>
