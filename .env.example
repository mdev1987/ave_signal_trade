# ============================================================
#  ave_signal_trade — Solana KOL-consensus trading bot
#  Mode: track-wallet (wallet consensus + shadow book)
# ============================================================

# ---------- Telegram notifications ----------
BOT_TOKEN=<reporting-bot-token>
CHAT_ID=<your-chat-id>

# ---------- Telegram signal feed (@gmgnsignals) ----------
TG_SIGNAL_ENABLED=false                 # disabled: tg-trade proved unprofitable
TG_SIGNAL_CHANNEL=gmgnsignals
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=tg_signal
TG_MIN_MC=5000
TG_MIN_LIQ=1000
TG_MIN_HOLDERS=10

# ---------- MemeTracker feed (@memetrackersol) ----------
MT_SESSION_NAME=tg_memetracker
MT_ENABLED=true
MT_MIN_MC=50000
MT_MIN_LIQ=5000
MT_MIN_HOLDERS=50
MT_MIN_VOL=10000

# ---------- data providers ----------
HELIUS_API_KEYS=<key1,key2,key3,key4>
SHYFT_API_KEY=<shyft-key>
TATUM_API_KEY=<tatum-key>
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RPM=300
VYBE_API_KEY=<vybe-key>

# ---------- CabalSpy (KOL wallet monitoring) ----------
CABALSPY_API_KEY=<cabalspy-key>
CABALSPY_SESSION=cabalspy

# ---------- Kolexplorer (KOL token monitor) ----------
KOLEXPLORER_ENABLED=true
KOLEXPLORER_SESSION=kolexplorer
KOLEXPLORER_MIN_KOLS=3
KOLEXPLORER_MIN_SCORE=1.5
KOLEXPLORER_POLL_S=30

# ---------- AveSignalMonitor (disabled: unprofitable) ----------
AVESM_ENABLED=false
AVESM_MIN_KOLS=2
AVESM_MIN_SCORE=1.0

# ---------- DBotX (fail-open rug filter) ----------
DBOTX_API_KEY=<dbotx-key>
DBOTX_SAFETY=1
DBOTX_TOP10_MAX=0.40
DBOTX_MINT_FREEZE_LIQ_MAX=15000

# ---------- RugCheck (rug detection) ----------
RUG_CHECK_API_KEY=<rugcheck-api-key>
RUG_CHECK_BASE_URL=https://api.rugcheck.xyz
RUG_CHECK_MAX_SCORE=30
RUG_CHECK_REJECT_DANGER=true

# ============ WALLET-QUALITY WEIGHTING ============
WALLET_PERF_PATH=wallet_performance.json
WALLET_WEIGHT_FLOOR_WIN=0.40
WALLET_WEIGHT_FULL_WIN=0.60
WALLET_PNL_TIER1=1000000
WALLET_PNL_TIER2=5000000
WALLET_WEIGHT_TIER1_MULT=1.25
WALLET_WEIGHT_TIER2_MULT=1.5
WALLET_DEFAULT_WEIGHT=0.5
WALLET_WEIGHT_MAX=2.0
CONSENSUS_WEIGHT_THRESHOLD=2.0
REQUIRE_STRONG_WALLET=true

# ---------- position management ----------
SIZE_SOL=0.05
ADAPTIVE_SIZING=true
SIZE_SOL_MIN=0.025
SIZE_SOL_MAX=0.08
TP_LADDER=1.2:0.4,1.8:0.3,3.0:0.3
TRAIL_ENABLED=true
TRAIL_START_MULT=1.4
TRAIL_RETRACE_PCT=0.15
HARD_STOP_PCT=0.30
BE_ARM_MULT=1.15
BE_BUFFER_PCT=0.0
START_BALANCE_SOL=2.0
SHADOW_STATE_FILE=shadow_book.json
MAX_OPEN_POSITIONS=8
PER_WALLET_MAX_POSITIONS=2
OPEN_MIN_WALLETS=3
OPEN_MAX_IMPACT_PCT=5.0
OPEN_MIN_H1_PCT=0.0
OPEN_MIN_M5_PCT=0.0
OPEN_MAX_M5_DUMP_PCT=-5.0
MTF_ALIGN_BONUS=0.3
PAIR_PERF_FILE=pair_performance.json
EARLY_FILTER_WINDOW_S=30.0
EARLY_FILTER_DD_PCT=10.0
EARLY_FILTER_GAIN_PCT=5.0
FLAT_TIMEOUT_H=2
MAX_HOLD_H=24
REENTRY_COOLDOWN_S=1800
STABLE_SYMBOLS=USDC,USDT,USD1,PYUSD,USDS,DAI,SOL,WSOL,WETH,WBTC,CBTC,JUP,RAY,ORCA

# ---------- watcher ----------
WATCH_POLL_S=120
WATCH_MIN_BUY_USD=50
WATCH_CONSENSUS_WALLETS=2
WATCH_CONSENSUS_WINDOW_S=600
WATCH_WEBHOOK_URL=
WATCH_WEBHOOK_PORT=8787
STATUS_EVERY_MIN=30

# ---------- Jupiter (sim / live) ----------
JUPITER_API_KEY=<jupiter-key>
JUPITER_SLIPPAGE_BPS=300
JUPITER_MAX_IMPACT_PCT=5.0
SIMULATE_BEFORE_EXECUTE=true

# ---------- PumpAPI (disabled) ----------
PUMPAPI_ENABLED=false

# ---------- RPC ----------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GATEKEEPER_RPC_URL=https://api.mainnet-beta.solana.com
PRIVATE_KEY=<throwaway-base58-private-key>

# ---------- mode ----------
DRY_RUN=true
